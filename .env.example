# openGym self-hosting configuration
# Copy this file to .env before running: cp .env.example .env

# Passkey/WebAuthn settings.
# For local use, keep these values as-is.
RP_ID=localhost
ORIGIN=http://localhost:8080
RP_NAME=openGym

# Host port exposed by the web container.
WEB_PORT=8080

# Optional administration settings.
# Add one or more user IDs after creating profiles (comma-separated).
# ADMIN_UIDS=
# Require an invite code for new profiles. Values: 1, true, yes, or on.
# INVITE_ONLY=0

# Session lifetime in days.
SESSION_DAYS=90

# Optional Web Push contact address or HTTPS origin.
# Defaults to ORIGIN when using HTTPS, otherwise mailto:admin@localhost.
# VAPID_SUBJECT=mailto:admin@example.com

